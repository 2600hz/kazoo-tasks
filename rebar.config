%% -*- mode: erlang; -*-
%% vim: set ft=erlang:

{pre_hooks, [{compile, "priv/schema_to_header.py ../crossbar/priv/couchdb/schemas/rates.json src/modules/kt_rates.hrl --no-overwrite"}
            ,{compile, "priv/list_task_modules.py --no-overwrite"}
            ]
}.

{post_hooks, [{clean, "rm -f src/modules/kt_rates.hrl"}
             ,{clean, "rm -f src/task_modules.hrl"}
             ,{clean, "rm -rf .task_modules"}
             ]}.
