{
    "_id": "_design/compactor",
    "autoupdate": false,
    "kazoo": {
        "view_map": [
            {
                "database": "dbs"
            },
            {
                "database": "_dbs"
            }
        ]
    },
    "language": "javascript",
    "views": {
        "listing_by_node": {
            "map": [
                "function(doc) {",
                "  for (var node in doc['by_node']) {",
                "    emit([node, doc._id], null);",
                "  }",
                "}"
            ]
        }
    }
}
